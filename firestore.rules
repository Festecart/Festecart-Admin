rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        (
          (
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.keys().hasAny(['roles']) &&
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.roles is list &&
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.roles.hasAny(['admin', 'super_admin'])
          ) ||
          (
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.keys().hasAny(['role']) &&
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role in ['admin', 'super_admin']
          )
        );
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        (
          (
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.keys().hasAny(['roles']) &&
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.roles is list &&
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.roles.hasAny(['super_admin'])
          ) ||
          (
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.keys().hasAny(['role']) &&
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'super_admin'
          )
        );
    }

    function isAffiliate() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'affiliate' &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.affiliate_id == request.auth.uid;
    }

    function isBasicRole(role) {
      return role in ['user', 'customer', 'vendor'];
    }

    function hasOnlyBasicRoleFields() {
      return (
        (
          !request.resource.data.keys().hasAny(['role']) ||
          isBasicRole(request.resource.data.role)
        ) &&
        (
          !request.resource.data.keys().hasAny(['roles']) ||
          (
            request.resource.data.roles is list &&
            request.resource.data.roles.size() > 0 &&
            request.resource.data.roles.hasOnly(['user', 'customer', 'vendor'])
          )
        ) &&
        (
          request.resource.data.keys().hasAny(['role']) ||
          request.resource.data.keys().hasAny(['roles'])
        )
      );
    }

    match /products/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.vendor_id == request.auth.uid || isAdmin());
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vendors/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /home_banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shipping_zones/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shipping_methods/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /delivery_pincodes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /delivery_zones/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();

      // Allow storefront coupon usage to increment without changing affiliate attribution.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total_uses']) &&
        request.resource.data.total_uses == resource.data.total_uses + 1;

      match /user_usage/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if true;
      }
    }

    match /user_roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        (
          hasOnlyBasicRoleFields() ||
          (
            request.auth.token.email == 'festecartdesi@gmail.com' &&
            request.resource.data.role == 'super_admin'
          )
        );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /user_profiles/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /phone_email_mappings/{phone} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
    }

    match /vendor_kyc/{vendorId} {
      allow read: if isAdmin() ||
        (isSignedIn() && get(/databases/$(database)/documents/vendors/$(vendorId)).data.user_id == request.auth.uid);
      allow write: if isSignedIn();
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    match /counters/{id} {
      allow read, write: if true;
    }

    match /cart_items/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /cart_items/{uid}/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /contact_enquiries/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /order_status_history/{id} {
      allow read, write: if isAdmin();
    }

    match /invoices/{id} {
      allow read, write: if isAdmin();
    }

    match /courier_vendors/{id} {
      allow read, write: if isAdmin();
    }

    match /admin_invitations/{id} {
      allow read, create, delete: if isAdmin();
      allow update: if isSignedIn();
    }

    match /email_tasks/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Affiliate profiles contain private contact information and commission terms.
    // Only the affiliate and admins can read them; trusted backend code writes them.
    match /affiliate_profiles/{affiliateId} {
      allow read: if isAdmin() || (isAffiliate() && request.auth.uid == affiliateId);
      allow write: if false;
    }

    // This server-maintained projection contains only the order details shown in the portal.
    // Affiliates can query their own records but cannot read or alter another affiliate's ledger.
    match /affiliate_order_analytics/{orderId} {
      allow read: if isAdmin() ||
        (isAffiliate() && resource.data.affiliate_id == request.auth.uid);
      allow write: if false;
    }
  }
}
